# E2E 环境层：Playwright 用的构建与运行配置。
# APP_ENV 不能是 production —— 那会让鉴权 cookie 带 secure，而 E2E 跑在 http 上。
# API_BASE 指向 tests/e2e/stub-api/server.mjs，SSR 与 CSR 请求都落到这个桩后端。
# 端口避开 3000 / 3100 / 2027 这些常用值：开发机上同时跑好几个项目是常态。
NUXT_REVALIDATE_SECRET=e2e_revalidate_secret
NUXT_PUBLIC_APP_ENV=development
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3399
NUXT_PUBLIC_API_BASE=http://127.0.0.1:2127/api/v1

NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BAIDU_SITE_VERIFICATION=

NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_ANALYTICS_SCRIPT_SRC=
NUXT_PUBLIC_ANALYTICS_DEFER_MS=3000

# 反向代理层数：E2E 直连 nuxt preview，没有代理
NUXT_TRUSTED_PROXY_DEPTH=0

# 可观测性：日志级别 debug|info|warn|error；客户端错误上报开关（默认开）
NUXT_LOG_LEVEL=info
NUXT_PUBLIC_ERROR_REPORTING_ENABLED=true
