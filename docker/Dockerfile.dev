# 文件职责：开发镜像。
# 提供 Node 与 pnpm，实际源码通过 docker-compose.dev.yaml 绑定挂载。
ARG PNPM_VERSION=11.5.2
FROM node:22-alpine

ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app
ENV HUSKY=0
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000 24678

CMD ["pnpm", "dev"]
