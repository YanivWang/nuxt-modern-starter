NUXT_REVALIDATE_SECRET=replace_with_random_revalidate_secret
NUXT_PUBLIC_APP_ENV=production
NUXT_PUBLIC_SITE_URL=https://example.com
NUXT_PUBLIC_API_BASE=https://api.example.com/api/v1

NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BAIDU_SITE_VERIFICATION=

NUXT_PUBLIC_ANALYTICS_ENABLED=false
NUXT_PUBLIC_ANALYTICS_SCRIPT_SRC=
NUXT_PUBLIC_ANALYTICS_DEFER_MS=3000

# 反向代理层数：0 = 直接对外，不信任 x-forwarded-for（限流 key 只认连接地址）。
# 前面挂了 N 层可信代理时设为 N；Compose 栈的 nginx 网关已在 base 里设为 1。
NUXT_TRUSTED_PROXY_DEPTH=0

# 可观测性：日志级别 debug|info|warn|error；客户端错误上报开关（默认开）
NUXT_LOG_LEVEL=info
NUXT_PUBLIC_ERROR_REPORTING_ENABLED=true
