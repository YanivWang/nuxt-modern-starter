{
  "name": "nuxt-modern-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.22.3 <23",
    "pnpm": ">=11.5.2 <12"
  },
  "scripts": {
    "build": "nuxt build --dotenv .env.prod",
    "build:dev": "nuxt build --dotenv .env.dev",
    "build:e2e": "nuxt build --dotenv .env.e2e",
    "build:prod": "nuxt build --dotenv .env.prod",
    "build:test": "nuxt build --dotenv .env.test",
    "commitlint": "commitlint --edit",
    "contract:check": "node scripts/sync-api-contract.mjs --check",
    "contract:sync": "node scripts/sync-api-contract.mjs",
    "depcruise": "depcruise app config server i18n --config .dependency-cruiser.cjs",
    "dev": "nuxt dev --dotenv .env.dev",
    "dev:prod": "nuxt dev --dotenv .env.prod",
    "dev:test": "nuxt dev --dotenv .env.test",
    "docker:build": "docker build -f docker/Dockerfile -t nuxt-modern-starter:local .",
    "docker:down": "docker compose --env-file .env.prod -f docker/docker-compose.base.yaml -f docker/docker-compose.yaml down",
    "docker:down:dev": "docker compose --env-file .env.dev -f docker/docker-compose.base.yaml -f docker/docker-compose.dev.yaml down",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.dev nuxt-modern-starter:local",
    "docker:up": "docker compose --env-file .env.prod -f docker/docker-compose.base.yaml -f docker/docker-compose.yaml up -d --build",
    "docker:up:dev": "docker compose --env-file .env.dev -f docker/docker-compose.base.yaml -f docker/docker-compose.dev.yaml up --build",
    "docs:build": "vitepress build docs-site",
    "docs:dev": "vitepress dev docs-site",
    "docs:preview": "vitepress preview docs-site",
    "docs:sync:check": "node docs-sync/check-docs-sync.mjs",
    "docs:sync:enrich": "node docs-sync/enrich-claims.mjs",
    "docs:sync:extract": "node docs-sync/extract-doc-references.mjs",
    "docs:sync:manifest": "node docs-sync/generate-manifest.mjs && prettier --write docs-sync/manifest.json docs-sync/batches.json docs-sync/COVERAGE.md",
    "docs:sync:reports": "node docs-sync/generate-batch-reports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:theme": "node scripts/generate-theme-scss.mjs",
    "i18n:check": "node scripts/i18n-manager.mjs check",
    "i18n:diff": "node scripts/i18n-manager.mjs diff",
    "i18n:scan": "node scripts/i18n-manager.mjs scan",
    "i18n:unused": "node scripts/i18n-manager.mjs unused",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "nuxt prepare",
    "prebuild": "node scripts/generate-theme-scss.mjs",
    "prebuild:dev": "node scripts/generate-theme-scss.mjs",
    "prebuild:e2e": "node scripts/generate-theme-scss.mjs",
    "prebuild:prod": "node scripts/generate-theme-scss.mjs",
    "prebuild:test": "node scripts/generate-theme-scss.mjs",
    "prepare": "husky",
    "preview": "nuxt preview",
    "quality": "corepack pnpm lint && corepack pnpm format:check && corepack pnpm stylelint && corepack pnpm typecheck && corepack pnpm i18n:check && corepack pnpm depcruise && corepack pnpm contract:check && corepack pnpm docs:sync:check && corepack pnpm build && corepack pnpm test",
    "stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "test": "vitest run",
    "test:component": "vitest run tests/component tests/nuxt",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "corepack pnpm run build:e2e && playwright test",
    "test:e2e:only": "playwright test",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md,css,scss}": "prettier --write"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "^1.4.6",
    "@pinia/nuxt": "^0.11.3",
    "@yanivjs/yaniv-editor": "0.3.0",
    "ant-design-vue": "^4.2.6",
    "h3": "^1.15.11",
    "nuxt": "^4.4.8",
    "ohash": "^2.0.12",
    "pinia": "^3.0.4",
    "spark-md5": "^3.0.2",
    "ufo": "^1.6.4",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@nuxt/eslint": "^1.12.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/spark-md5": "^3.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.5.0",
    "ajv": "^8.20.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "^10.6.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1",
    "lint-staged": "^17.0.8",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "sass": "^1.97.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.8"
  }
}
